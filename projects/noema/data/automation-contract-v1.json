{
  "contract_id": "NOEMA-AUTOMATION-CONTRACT-V1",
  "version": "1.0.0",
  "timezone": "Europe/Stockholm",
  "principles": [
    "Automation output is workflow state, never evidence by itself.",
    "Discovery jobs may create candidates but may not approve claims or relationships.",
    "Every state-changing research job should emit a run manifest.",
    "Unknown, missing, contested and absent states remain distinct.",
    "Scheduled outputs must write only to their declared destinations."
  ],
  "tasks": [
    {
      "task_type": "GITHUB_DISCOVERY",
      "scheduler": "GITHUB_ACTIONS",
      "cadence": "DAILY",
      "schedule": "17 4 * * * UTC",
      "expected_interval_hours": 26,
      "authority": "CANDIDATE_DISCOVERY_ONLY",
      "writes": ["Actions artifact: noema-crossref-candidates", "projects/noema/data/runs/github-discovery-*.json"],
      "next_stage": "DAILY_INGEST"
    },
    {
      "task_type": "DAILY_INGEST",
      "scheduler": "CHATGPT_AUTOMATION",
      "cadence": "DAILY",
      "schedule": "approximately 08:00 Europe/Stockholm",
      "expected_interval_hours": 30,
      "authority": "CANDIDATE_TRIAGE_ONLY",
      "writes": ["projects/noema/data/candidates/daily/YYYY-MM-DD.json", "projects/noema/data/runs/chatgpt-daily-YYYY-MM-DD.json"],
      "next_stage": "HUMAN_REVIEW"
    },
    {
      "task_type": "DPLACE_BENCHMARK",
      "scheduler": "GITHUB_ACTIONS",
      "cadence": "WEEKLY_MONDAY",
      "schedule": "43 5 * * 1 UTC",
      "expected_interval_hours": 190,
      "authority": "COVERAGE_REFRESH_ONLY",
      "writes": ["projects/noema/site/societies.json", "projects/noema/data/runs/dplace-benchmark-*.json"],
      "next_stage": "RELIGION_FEDERATION"
    },
    {
      "task_type": "RELIGION_FEDERATION",
      "scheduler": "GITHUB_ACTIONS",
      "cadence": "WEEKLY_MONDAY",
      "schedule": "17 5 * * 1 UTC",
      "expected_interval_hours": 190,
      "authority": "DETERMINISTIC_PROJECTION_AND_DESCRIPTIVE_ANALYSIS",
      "writes": ["projects/noema/site/religion-decomposition.json", "projects/noema/site/drh-decomposition.json", "projects/noema/site/drh-catalog.json", "projects/noema/site/dplace-religion-variables.json", "projects/noema/site/religion-federation.json", "projects/noema/site/pattern-candidates.json", "projects/noema/site/coverage-matrix.json", "projects/noema/site/research-health.json", "projects/noema/data/runs/religion-federation-*.json"],
      "next_stage": "PATTERN_REVIEW"
    },
    {
      "task_type": "WEEKLY_REANALYSIS",
      "scheduler": "CHATGPT_AUTOMATION",
      "cadence": "WEEKLY_SUNDAY",
      "schedule": "approximately 08:00 Europe/Stockholm",
      "expected_interval_hours": 190,
      "authority": "HYPOTHESIS_REVISION_CANDIDATES_ONLY",
      "writes": ["projects/noema/research/reanalysis/YYYY-MM-DD-weekly-reanalysis.md", "projects/noema/data/runs/chatgpt-weekly-YYYY-MM-DD.json"],
      "next_stage": "HUMAN_REVIEW"
    },
    {
      "task_type": "MONTHLY_DISCOVERY",
      "scheduler": "CHATGPT_AUTOMATION",
      "cadence": "MONTHLY_FIRST_DAY",
      "schedule": "approximately 08:00 Europe/Stockholm",
      "expected_interval_hours": 780,
      "authority": "RELATIONSHIP_AND_HYPOTHESIS_CANDIDATES_ONLY",
      "writes": ["projects/noema/data/candidates/monthly/YYYY-MM-DD.json", "projects/noema/research/monthly/YYYY-MM-DD-monthly-discovery.md", "projects/noema/data/runs/chatgpt-monthly-YYYY-MM-DD.json"],
      "next_stage": "HUMAN_REVIEW"
    },
    {
      "task_type": "MEDIA_DISCOVERY",
      "scheduler": "GITHUB_ACTIONS",
      "cadence": "WEEKLY_WEDNESDAY",
      "schedule": "43 6 * * 3 UTC",
      "expected_interval_hours": 190,
      "authority": "MEDIA_CANDIDATE_DISCOVERY_ONLY",
      "writes": ["projects/noema/data/candidates/wikimedia-media-candidates.json", "projects/noema/data/runs/media-discovery-*.json"],
      "next_stage": "IDENTITY_AND_RIGHTS_REVIEW"
    }
  ]
}
