  "status": "PLANNING_AND_ORCHESTRATION_CONTRACT",
  "principles": [
    "Discovery breadth is optimized for information gain, source independence and coverage gaps, not raw item volume.",
    "Discovery metadata is never evidence.",
    "Every source uses an explicit freshness cursor or immutable version identifier where available.",
    "Every source declares rights/redistribution policy before full-text or record persistence.",
    "Candidate identity is deduplicated by authoritative IDs and canonical locators; title-only deduplication is forbidden.",
    "Source dependence is tracked separately from source count.",
    "Human review remains required before promotion to approved evidence.",
    "Unknown, unobserved, absent-after-search and preservation-unlikely remain distinct states."
  ],
