{
  "schema_id": "NOEMA-DECOMPOSITION-1",
  "version": "1.0.0",
  "purpose": "Decompose religious, spiritual and belief systems into independently searchable components while preserving source-specific terminology and uncertainty.",
  "principles": [
    "A named religion is a bundle, not an atomic category.",
    "Similar components do not imply common origin.",
    "Practice, claimed meaning, participant experience and analyst interpretation are separate fields.",
    "Absence of coding is UNKNOWN, never FALSE.",
    "Historical transmission, shared ancestry, convergence and local innovation remain competing mechanisms until tested.",
    "Substance use is one altered-state induction route among many and never defines shamanism by itself.",
    "Indigenous or community-restricted knowledge must retain access controls and community terminology."
  ],
