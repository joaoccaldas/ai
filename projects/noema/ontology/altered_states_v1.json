  },
  "substance_classes": {
    "CLASSIC_PSYCHEDELIC": {"mechanism_family":"primarily_5HT2A_agonism","example_compounds":["psilocin/psilocybin", "DMT", "mescaline", "LSD"],"note":"Examples classify pharmacology, not ritual history."},
    "DISSOCIATIVE": {"mechanism_family":"commonly_NMDA_antagonism_or_related","example_compounds":["ketamine", "ibogaine_complex_profile"],"note":"Ibogaine has mixed pharmacology and should not be reduced to one receptor class."},
    "DELIRIANT": {"mechanism_family":"commonly_anticholinergic_or_related","example_compounds":["atropine", "scopolamine"],"note":"High toxicity and distinct phenomenology require separation from classic psychedelics."},
