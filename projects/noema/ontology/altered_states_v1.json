{
  "ontology_id": "NOEMA-ALTERED-STATES-V1",
  "version": "1.0.0",
  "purpose": "Represent altered states, induction methods, psychoactive substances, phenomenology, cultural framing and downstream belief transmission as separate variables.",
  "epistemic_guards": [
    "A reported experience is evidence that an experience was reported, not that its interpreted ontology is externally true.",
    "Substance identity does not determine experience content without dose, preparation, set, setting and cultural priors.",
    "Shared phenomenology does not establish shared historical origin.",
    "Ritual use does not imply psychedelic use; shamanic roles do not imply psychoactive substances.",
    "Psychoactive use does not imply religious use; medicinal, social and recreational contexts must remain distinct.",
    "Archaeological residue establishes a chemical/material trace only to the level supported by context and analytical method."
  ],
