    "STIMULANT": {"mechanism_family":"catecholaminergic_or_related","example_compounds":["cocaine", "caffeine"],"note":"Coca preparations and purified cocaine must not be treated as identical contexts."},
    "SEDATIVE_HYPNOTIC": {"mechanism_family":"multiple","example_compounds":["ethanol"]},
    "OPIOID": {"mechanism_family":"opioid_receptor_activity","example_compounds":["morphine", "opium_alkaloids"]},
    "NICOTINIC": {"mechanism_family":"nicotinic_acetylcholine_receptor_activity","example_compounds":["nicotine"]},
    "KAVA_LIKE": {"mechanism_family":"mixed","example_compounds":["kavalactones"]},
    "AMANITA_LIKE": {"mechanism_family":"GABAergic_and_glutamatergic","example_compounds":["muscimol", "ibotenic_acid"]},
    "OTHER_OR_UNKNOWN": {"mechanism_family":"unknown_or_mixed","example_compounds":[]}
  },
