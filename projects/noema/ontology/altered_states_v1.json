    "DEPRIVATION_STRESS": ["fasting", "sleep_deprivation", "sensory_deprivation", "isolation", "prolonged_vigil", "pain", "heat", "cold"],
    "SOCIAL_RITUAL": ["possession_ritual", "collective_synchrony", "initiation", "dream_incubation", "guided_imagery", "suggestion"],
