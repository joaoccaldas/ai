{
  "ontology_id": "NOEMA-DECOMPOSITION-V1",
  "version": "1.1.0",
  "purpose": "Decompose religious, spiritual, supernatural and ritual systems into comparable first-principle components without assuming that any tradition is internally uniform or historically descended from another.",
  "unit_of_comparison": "FEATURE_ASSERTION",
  "principles": [
    "Tradition labels are containers, not explanatory variables.",
    "Compare components before comparing whole religions.",
    "Presence, absence, unknown and contested are distinct states.",
    "Shared feature does not imply shared origin.",
    "Material form does not imply semantic meaning.",
    "Experience does not establish ontology.",
    "Ritual function and participant interpretation may differ.",
    "Contemporary, historical and reconstructed states must never be silently merged.",
    "Internal variation by sect, region, period, class, gender and practitioner role is first-class data.",
    "Indigenous/community-restricted knowledge may be indexed as restricted without exposing protected content."
  ],
