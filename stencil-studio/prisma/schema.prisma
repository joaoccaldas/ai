// Stencil Studio — multi-tenant schema
// A Studio is the tenant (a tattoo parlour). Users belong to a Studio.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Provider is set from DATABASE_URL by scripts/set-db-provider.mjs
  // (sqlite locally, postgresql in production). Do not edit by hand.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Studio {
  id   String @id @default(cuid())
  name String
  slug String @unique

  // white-label branding
  logoUrl     String?
  accentColor String  @default("#d24b3f")
  tagline     String  @default("See it before you ink")

  // bring-your-own Higgsfield key (secret stored AES-256-GCM encrypted)
  hfKeyId        String?
  hfKeySecretEnc String?
  hfConnected    Boolean @default(false)

  // billing (Stripe) — flat software licence
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String    @default("none") // none|trialing|active|past_due|canceled
  plan                 String    @default("none")
  trialEndsAt          DateTime?

  // booking / conversion
  bookingEnabled Boolean @default(true)
  currency       String  @default("GBP")
  depositHint    String? // e.g. "£50 deposit secures your slot"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  designs  Design[]
  sessions ClientSession[]
  renders  Render[]
  bookings Booking[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("owner") // owner|artist
  studioId     String
  studio       Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([studioId])
}

model Design {
  id        String   @id @default(cuid())
  studioId  String
  studio    Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  name      String
  imageUrl  String
  kind      String   @default("flash") // flash|upload
  createdAt DateTime @default(now())

  @@index([studioId])
}

model ClientSession {
  id            String   @id @default(cuid())
  studioId      String
  studio        Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  clientName    String?
  clientContact String?
  photoUrl      String?
  consent       Boolean  @default(false)
  shareToken    String   @unique @default(cuid())
  createdAt     DateTime @default(now())

  renders  Render[]
  bookings Booking[]

  @@index([studioId])
}

model Booking {
  id        String  @id @default(cuid())
  studioId  String
  studio    Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  sessionId String?
  session   ClientSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  clientName    String
  clientContact String
  preferredDate String?
  designName    String?
  message       String?
  status        String   @default("requested") // requested|booked|completed|cancelled
  depositPaid   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@index([status])
}

model Render {
  id                String   @id @default(cuid())
  studioId          String
  studio            Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  sessionId         String
  session           ClientSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  designId          String?
  designName        String?
  status            String   @default("queued") // queued|processing|completed|failed
  provider          String   @default("higgsfield")
  providerRequestId String?
  providerStatusUrl String?
  prompt            String?
  placement         String?
  bodyUrl           String?
  designUrl         String?
  compositeUrl      String?
  resultUrl         String?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([studioId])
  @@index([sessionId])
}
