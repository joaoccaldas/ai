{
  "schema": "caldas.scene/v0",
  "id": "scene:spatial-lab:world-zero-r0",
  "name": "World Zero Benchmark Lab",
  "lifecycle": "research",
  "semantic_authority": "procedural-mesh",
  "source": {
    "repository": "joaoccaldas/ai",
    "branch": "feat/spatial-lab-v0"
  },
  "assets": [
    {
      "role": "hero-bike",
      "semantic_id": "bike:speedmax:study",
      "bytes": 2081248,
      "source": {
        "repository": "joaoccaldas/konam",
        "revision": "6feb3203ecc3e5d98f9b75a970699d9486d087ca",
        "path": "assets/museum/speedmax_web.glb"
      },
      "delivery": {
        "id": "speedmax",
        "transport": "same-origin-auth-gateway"
      },
      "fallback": "procedural-bike"
    }
  ],
  "quality_policy": {
    "core": "runtime/quality.js",
    "auto_governor": "p95-frame-time",
    "manual_tiers": [
      "low",
      "balanced",
      "high",
      "ultra"
    ]
  },
  "benchmark_policy": {
    "core": "runtime/benchmark.js",
    "warmup_seconds": 3,
    "measured_seconds": 12,
    "upload": true,
    "persistence": "owner-scoped-supabase-rls",
    "modes": [
      "screen",
      "xr"
    ],
    "xr_mode_rule": "Measurement starts only after renderer.xr.isPresenting is true.",
    "adaptive_quality_during_measurement": false,
    "xr_session_fields": [
      "xr_active",
      "xr_frame_rate"
    ]
  },
  "acceptance": [
    "auth-gated",
    "phone-portrait",
    "phone-landscape",
    "desktop",
    "quest-webxr",
    "real-speedmax-or-explicit-fallback",
    "frame-metrics",
    "safe-renderer-fallback"
  ],
  "interaction_policy": {
    "core": "runtime/xr-interactions.js",
    "input_model": "webxr-target-ray-select",
    "hand_compatible": "via-browser-select-events",
    "device_sniffing": false,
    "locomotion": "semantic-teleport-anchors",
    "grab_physics": "not_yet_enabled",
    "direct_manipulation": "near-fingertip pinch for grabbable objects",
    "throwable_objects": [
      "idea-orb"
    ],
    "non_throwable_selectables": [
      "speedmax",
      "agents",
      "portals"
    ],
    "input_priority": [
      "direct-hand-pinch",
      "target-ray-select"
    ],
    "visible_hand_model": "spheres",
    "panel_manipulation": "one-hand move + two-hand uniform resize + dock snap",
    "locomotion_core": "runtime/xr-locomotion.js",
    "continuous_joystick_motion": false,
    "teleport_disabled_in_mr": true,
    "teleport_disabled_during_benchmark": true
  },
  "spatial_ui": {
    "command_wall": {
      "core": "runtime/spatial-studio.js",
      "layout": "three-panel-curved",
      "surfaces": [
        "caldas-agents",
        "kona-world",
        "performance-live"
      ]
    },
    "agent_ring": {
      "agents": [
        "SOL",
        "LUNA",
        "TERRA",
        "ATLAS",
        "NOVA"
      ],
      "center_object": "idea-orb"
    }
  },
  "mixed_reality": {
    "mode": "immersive-ar",
    "capability_detected": true,
    "shell_visibility": "hide architectural shell; retain spatial UI, agents, portals and product objects",
    "fallback": "immersive-vr or flat screen"
  },
  "spatial_layout": {
    "core": "runtime/spatial-layout.js",
    "persistence": "owner-scoped-supabase-rls",
    "panels": [
      "caldas-agents",
      "kona-world",
      "performance-live"
    ],
    "one_hand": "move",
    "two_hand": "uniform-resize",
    "throwing": false,
    "docking": "snap-to-original-command-wall-slot",
    "reset_control": "reset-panels",
    "stored_fields": [
      "position",
      "quaternion",
      "uniform-scale",
      "docked"
    ]
  },
  "locomotion": {
    "anchors": [
      "CENTER",
      "AGENTS",
      "BIKE",
      "COMMAND WALL"
    ],
    "movement": "instant horizontal rig translation preserving current room-scale head offset",
    "comfort": "no continuous artificial motion in V0",
    "mr_behavior": "physical movement only"
  }
}
